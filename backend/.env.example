# ---- polaris backend env ----
# Google OAuth (web client, see ../oauth-content.json)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# JWT session
JWT_SECRET=change-me-please-32-bytes-min
JWT_ALG=HS256
SESSION_TTL_SECONDS=2592000

# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Redis
REDIS_URL=redis://localhost:6379/0

# GitHub duplicate detection and sandbox-originated pushes
GITHUB_ACCESS_TOKEN=
GITHUB_ORG=Polaris-Implementations
GITHUB_API_URL=https://api.github.com
GITHUB_REPO_PRIVATE=false

# Billing provider integration. The worker starts only after paid status.
PAYMENT_CHECKOUT_URL=
BILLING_WEBHOOK_SECRET=

# Ingest / worker
INGEST_TOP_N_CITATIONS=8
WORKER_CONCURRENCY_HINT=1

# CORS (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting (per IP)
RATELIMIT_DEFAULT=120/minute
RATELIMIT_AUTH=15/minute
RATELIMIT_INGEST=8/minute
