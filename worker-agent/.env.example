# ---- polaris worker env ----

# DeepInfra (langchain-deepinfra reads this env var)
DEEPINFRA_API_TOKEN=
# Default model used for every agent (override per-agent with the *_MODEL vars)
# NOTE: deepseek-ai/DeepSeek-V4-Flash may not be published on DeepInfra -- pick a real id
DEFAULT_MODEL=deepseek-ai/DeepSeek-V4-Flash
READ_MODEL=
RESEARCH_MODEL=
PLAN_MODEL=
CODE_MODEL=
ORCHESTRATOR_MODEL=
# Max retries an agent may loop before the orchestrator forces it through
AGENT_MAX_STEPS=12

# Redis (same instance as backend)
REDIS_URL=redis://localhost:6379/0

# Backend URL + shared secret for /internal/usage token reports.
# WORKER_SECRET must match the backend's WORKER_SECRET.
BACKEND_URL=http://localhost:3000
WORKER_SECRET=

# Supabase (read papers + persist traces)
SUPABASE_URL=
SUPABASE_KEY=

# Arxiv tool
ARXIV_MAX_CITATIONS=8

# Daytona sandbox (app.daytona.io) -- we REUSE an existing sandbox by name
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=global
DAYTONA_SANDBOX_NAME=Polaris     # name of the pre-existing running sandbox to reuse
DAYTONA_WORKDIR=/home/daytona    # directory inside the sandbox to write files into