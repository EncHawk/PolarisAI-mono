# ── Backend ──────────────────────────────────────────────────────
# Google ID token verification (used ONCE by POST /auth/exchange to mint an API key).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared secret the worker presents on X-Worker-Secret when posting
# /internal/usage reports. Both backend & worker must have the same value.
WORKER_SECRET=

SESSION_TTL_SECONDS=2592000
ENVIRONMENT=development

# Supabase + Redis
SUPABASE_URL=
SUPABASE_KEY=
REDIS_URL=redis://localhost:6379/0

# Razorpay (subscriptions -> credit grants)
RAZORPAY_KEY_ID=rzp_test_THmhNynXZeDKCN
RAZORPAY_KEY_SECRET=xGLCixrbS4FBodiJCFrfKRZi
RAZORPAY_WEBHOOK_SECRET=
BILLING_WEBHOOK_SECRET=

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
INGEST_TOP_N_CITATIONS=8
RATELIMIT_DEFAULT=120/minute
RATELIMIT_AUTH=15/minute
RATELIMIT_INGEST=8/minute

# ── Worker ───────────────────────────────────────────────────────
DEEPINFRA_API_TOKEN=
DEFAULT_MODEL=deepseek-ai/DeepSeek-V4-Flash
BACKEND_URL=http://localhost:3000
WORKER_SECRET=

# ── NextJS client (must be NEXT_PUBLIC_ for browser exposure) ─────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_REPLACE