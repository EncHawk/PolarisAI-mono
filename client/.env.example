# Polaris frontend environment variables
# This is a Vite app, so all variables exposed to the browser must be prefixed with VITE_.

# Backend API base URL (default: http://localhost:3000)
VITE_API_BASE_URL=http://localhost:3000

# Google OAuth web client ID used by the "Continue with Google" button.
# Must match the GOOGLE_CLIENT_ID configured in the backend.
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
